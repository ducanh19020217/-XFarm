generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  ACCOUNTANT
  SALES
  WORKER
}

enum AreaType {
  ZONE
  FIELD
  GREENHOUSE
  BARN
  POND
  VISITOR_ZONE
  WAREHOUSE_ZONE
}

enum CycleKind {
  CROP
  LIVESTOCK
  AQUA
}

enum CycleStatus {
  PLANNED
  ACTIVE
  HARVESTING
  CLOSED
  CANCELLED
}

enum ActivityType {
  SOWING
  PLANTING
  FERTILIZING
  SPRAYING
  IRRIGATION
  PRUNING
  WEEDING
  FEEDING
  VACCINATION
  TREATMENT
  WATER_TEST
  STOCKING
  MORTALITY
  WEIGHING
  HARVEST
  CLEANING
  OTHER
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalStatus {
  ALIVE
  SOLD
  DEAD
}

enum AnimalEventType {
  VACCINATION
  TREATMENT
  BREEDING
  BIRTH
  WEIGHING
  DEATH
  SALE
}

enum ItemCategory {
  SEED
  FERTILIZER
  PESTICIDE
  FEED
  VETERINARY
  TOOL
  PACKAGING
  PRODUCE
  LIVESTOCK_PRODUCT
  AQUA_PRODUCT
  OTHER
}

enum StockMoveType {
  IN
  OUT
  TRANSFER
  ADJUST
}

enum StockMoveDirection {
  IN
  OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PayType {
  DAILY
  MONTHLY
  PIECE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum CustomerType {
  RETAIL
  WHOLESALE
  AGENT
}

enum SalesChannel {
  ADMIN
  WEBSHOP
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CASH
  VNPAY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  BROKEN
  RETIRED
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
}

enum SensorType {
  TEMP
  HUMIDITY
  SOIL_MOISTURE
  PH
  DO
  LIGHT
  OTHER
}

enum AlertOp {
  GT
  LT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(WORKER)
  isActive     Boolean  @default(true)
  employeeId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  media                    Media[]
  areasCreated             Area[]             @relation("AreasCreated")
  cyclesCreated            Cycle[]            @relation("CyclesCreated")
  activitiesCreated        Activity[]         @relation("ActivitiesCreated")
  activitiesPerformed      Activity[]         @relation("ActivitiesPerformed")
  animalGroupsCreated      AnimalGroup[]      @relation("AnimalGroupsCreated")
  animalsCreated           Animal[]           @relation("AnimalsCreated")
  animalEventsCreated      AnimalEvent[]      @relation("AnimalEventsCreated")
  activityMaterialsCreated ActivityMaterial[] @relation("ActivityMaterialsCreated")
  suppliersCreated         Supplier[]         @relation("SuppliersCreated")
  purchaseOrdersCreated    PurchaseOrder[]    @relation("PurchaseOrdersCreated")
  harvestLotsCreated       HarvestLot[]       @relation("HarvestLotsCreated")
  productsCreated          Product[]          @relation("ProductsCreated")
  postsCreated             Post[]             @relation("PostsCreated")
  employee                 Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  payrollsApproved         Payroll[]          @relation("PayrollApproved")
  pagesCreated             Page[]             @relation("PagesCreated")
  customerAccounts         Customer[]         @relation("CustomerAccount")
  customersCreated         Customer[]         @relation("CustomersCreated")
  salesOrdersCreated       SalesOrder[]       @relation("SalesOrdersCreated")
  paymentsCreated          Payment[]          @relation("PaymentsCreated")
  transactionsCreated      Transaction[]      @relation("TransactionsCreated")
  toursCreated             Tour[]             @relation("ToursCreated")
  tourSlotsCreated         TourSlot[]         @relation("TourSlotsCreated")
  bookingsCreated          Booking[]          @relation("BookingsCreated")
  equipmentsCreated           Equipment[]           @relation("EquipmentsCreated")
  maintenanceSchedulesCreated MaintenanceSchedule[] @relation("MaintenanceSchedulesCreated")
  maintenanceLogsCreated      MaintenanceLog[]      @relation("MaintenanceLogsCreated")
  maintenanceLogsPerformed    MaintenanceLog[]      @relation("MaintenanceLogsPerformed")
  sensorsCreated              Sensor[]              @relation("SensorsCreated")
  alertRulesCreated           AlertRule[]           @relation("AlertRulesCreated")

  @@index([employeeId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

model Sequence {
  id      String @id @default(cuid())
  key     String
  year    Int
  current Int    @default(0)

  @@unique([key, year])
  @@map("sequences")
}

model Media {
  id           String   @id @default(cuid())
  url          String
  key          String
  mime         String
  size         Int
  alt          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedById String?

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@map("media")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Area {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        AreaType
  parentId    String?
  areaM2      Decimal? @db.Decimal(18, 3)
  geojson     Json?
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Area?         @relation("AreaHierarchy", fields: [parentId], references: [id])
  children     Area[]        @relation("AreaHierarchy")
  createdBy    User?         @relation("AreasCreated", fields: [createdById], references: [id])
  cycles       Cycle[]
  activities   Activity[]
  animalGroups AnimalGroup[]
  warehouses   Warehouse[]
  tasks        Task[]
  equipments   Equipment[]
  sensors      Sensor[]

  @@index([parentId])
  @@index([type])
  @@map("areas")
}

model Cycle {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String
  kind            CycleKind
  areaId          String
  species         String
  variety         String?
  startDate       DateTime
  expectedEndDate DateTime?
  endDate         DateTime?
  status          CycleStatus @default(PLANNED)
  expectedYield   Decimal?    @db.Decimal(18, 3)
  yieldUnit       String?
  initialQuantity Decimal?    @db.Decimal(18, 3)
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  area         Area          @relation(fields: [areaId], references: [id])
  createdBy    User?         @relation("CyclesCreated", fields: [createdById], references: [id])
  activities   Activity[]
  harvestLots  HarvestLot[]
  animalGroups AnimalGroup[]
  tasks        Task[]
  attendances  Attendance[]
  transactions Transaction[]

  @@index([areaId, status])
  @@index([status])
  @@map("cycles")
}

model Activity {
  id            String       @id @default(cuid())
  cycleId       String?
  areaId        String
  type          ActivityType
  performedAt   DateTime     @default(now())
  performedById String?
  quantity      Decimal?     @db.Decimal(18, 3)
  unit          String?
  data          Json?
  notes         String?
  mediaIds      String[]     @default([])
  clientId      String?      @unique
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cycle       Cycle?             @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  area        Area               @relation(fields: [areaId], references: [id])
  performedBy User?              @relation("ActivitiesPerformed", fields: [performedById], references: [id])
  createdBy   User?              @relation("ActivitiesCreated", fields: [createdById], references: [id])
  materials   ActivityMaterial[]
  harvestLot  HarvestLot?
  task        Task?

  @@index([cycleId, performedAt])
  @@index([areaId, performedAt])
  @@index([type])
  @@index([performedById, performedAt])
  @@map("activities")
}

model AnimalGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  cycleId     String
  species     String
  breed       String?
  headCount   Int      @default(0)
  areaId      String
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycle     Cycle    @relation(fields: [cycleId], references: [id])
  area      Area     @relation(fields: [areaId], references: [id])
  createdBy User?    @relation("AnimalGroupsCreated", fields: [createdById], references: [id])
  animals   Animal[]

  @@index([cycleId])
  @@index([areaId])
  @@map("animal_groups")
}

model Animal {
  id          String       @id @default(cuid())
  tag         String       @unique
  groupId     String?
  species     String
  breed       String?
  sex         AnimalSex    @default(UNKNOWN)
  birthDate   DateTime?
  status      AnimalStatus @default(ALIVE)
  motherId    String?
  notes       String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group     AnimalGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  mother    Animal?       @relation("AnimalOffspring", fields: [motherId], references: [id], onDelete: SetNull)
  offspring Animal[]      @relation("AnimalOffspring")
  createdBy User?         @relation("AnimalsCreated", fields: [createdById], references: [id])
  events    AnimalEvent[]

  @@index([groupId])
  @@index([motherId])
  @@index([status])
  @@map("animals")
}

model AnimalEvent {
  id          String          @id @default(cuid())
  animalId    String
  type        AnimalEventType
  date        DateTime        @default(now())
  data        Json?
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("AnimalEventsCreated", fields: [createdById], references: [id])

  @@index([animalId, date])
  @@index([type])
  @@map("animal_events")
}

model Item {
  id         String       @id @default(cuid())
  sku        String       @unique
  name       String
  category   ItemCategory
  unit       String
  minStock   Decimal?     @db.Decimal(18, 3)
  isSellable Boolean      @default(false)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  stockLots          StockLot[]
  stockMoves         StockMove[]
  activityMaterials  ActivityMaterial[]
  purchaseOrderLines PurchaseOrderLine[]
  harvestLots        HarvestLot[]
  products           Product[]
  salesOrderLines    SalesOrderLine[]

  @@index([category, isActive])
  @@map("items")
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  areaId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area        Area?        @relation(fields: [areaId], references: [id])
  stockLots   StockLot[]
  harvestLots HarvestLot[]
  movesFrom   StockMove[]  @relation("StockMovesFrom")
  movesTo     StockMove[]  @relation("StockMovesTo")
  salesOrders SalesOrder[]

  @@index([areaId])
  @@map("warehouses")
}

model StockLot {
  id           String    @id @default(cuid())
  itemId       String
  lotCode      String
  expiryDate   DateTime?
  harvestLotId String?   @unique
  warehouseId  String?
  unitCost     Decimal   @db.Decimal(18, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  item              Item               @relation(fields: [itemId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  stockMoves        StockMove[]
  activityMaterials ActivityMaterial[]
  salesOrderLines   SalesOrderLine[]
  harvestLot        HarvestLot?        @relation(fields: [harvestLotId], references: [id])

  @@unique([itemId, lotCode])
  @@index([itemId, expiryDate])
  @@index([warehouseId])
  @@map("stock_lots")
}

model HarvestLot {
  id            String   @id @default(cuid())
  code          String   @unique
  traceCode     String   @unique
  cycleId       String
  activityId    String   @unique
  itemId        String
  quantity      Decimal  @db.Decimal(18, 3)
  unit          String
  harvestedAt   DateTime
  warehouseId   String
  qualityGrade  String?
  certification String?
  isPublic      Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cycle     Cycle     @relation(fields: [cycleId], references: [id])
  activity  Activity  @relation(fields: [activityId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User?     @relation("HarvestLotsCreated", fields: [createdById], references: [id])
  stockLot  StockLot?

  @@index([cycleId, harvestedAt])
  @@index([itemId])
  @@index([warehouseId])
  @@index([isPublic, harvestedAt])
  @@map("harvest_lots")
}

model StockMove {
  id              String              @id @default(cuid())
  type            StockMoveType
  itemId          String
  stockLotId      String?
  fromWarehouseId String?
  toWarehouseId   String?
  quantity        Decimal             @db.Decimal(18, 3)
  unitCost        Decimal             @db.Decimal(18, 2)
  direction       StockMoveDirection?
  refType         String?
  refId           String?
  movedAt         DateTime            @default(now())
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  item          Item       @relation(fields: [itemId], references: [id])
  stockLot      StockLot?  @relation(fields: [stockLotId], references: [id])
  fromWarehouse Warehouse? @relation("StockMovesFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("StockMovesTo", fields: [toWarehouseId], references: [id])

  @@index([itemId, stockLotId])
  @@index([itemId, stockLotId, type])
  @@index([refType, refId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([movedAt])
  @@index([fromWarehouseId, movedAt])
  @@index([toWarehouseId, movedAt])
  @@map("stock_moves")
}

model ActivityMaterial {
  id          String   @id @default(cuid())
  activityId  String
  itemId      String
  stockLotId  String?
  quantity    Decimal  @db.Decimal(18, 3)
  unitCost    Decimal  @db.Decimal(18, 2)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity  Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])
  stockLot  StockLot? @relation(fields: [stockLotId], references: [id])
  createdBy User?     @relation("ActivityMaterialsCreated", fields: [createdById], references: [id])

  @@index([activityId])
  @@index([itemId])
  @@map("activity_materials")
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  phone       String?
  address     String?
  taxCode     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User?           @relation("SuppliersCreated", fields: [createdById], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  code        String              @unique
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime            @default(now())
  total       Decimal             @db.Decimal(18, 2)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation("PurchaseOrdersCreated", fields: [createdById], references: [id])
  lines     PurchaseOrderLine[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String   @id @default(cuid())
  poId        String
  itemId      String
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @db.Decimal(18, 2)
  receivedQty Decimal  @default(0) @db.Decimal(18, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([poId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

model Alert {
  id        String    @id @default(cuid())
  ruleId    String?
  type      String
  message   String
  refType   String?
  refId     String?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())
  readAt    DateTime?
  rule AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@index([refType, refId])
  @@index([readAt])
  @@map("alerts")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  itemId      String
  description String
  price       Decimal  @db.Decimal(18, 2)
  unit        String
  mediaIds    String[] @default([])
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item            Item             @relation(fields: [itemId], references: [id])
  createdBy       User?            @relation("ProductsCreated", fields: [createdById], references: [id])
  salesOrderLines SalesOrderLine[]

  @@index([isPublished, sortOrder])
  @@index([itemId])
  @@map("products")
}

model Post {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  excerpt      String
  content      String
  coverMediaId String?
  publishedAt  DateTime?
  status       PostStatus @default(DRAFT)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdBy User? @relation("PostsCreated", fields: [createdById], references: [id])

  @@index([status, publishedAt])
  @@map("posts")
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("PagesCreated", fields: [createdById], references: [id])

  @@map("pages")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Employee {
  id        String   @id @default(cuid())
  code      String   @unique
  fullName  String
  phone     String?
  position  String
  payType   PayType
  baseRate  Decimal  @db.Decimal(18, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  tasks       Task[]
  attendances Attendance[]
  payrolls    Payroll[]

  @@index([payType])
  @@index([isActive])
  @@map("employees")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  assigneeId  String
  areaId      String?
  cycleId     String?
  dueDate     DateTime
  status      TaskStatus @default(TODO)
  activityId  String?    @unique
  completedAt DateTime?
  clientId    String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee Employee  @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  cycle    Cycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([areaId])
  @@index([cycleId])
  @@index([status])
  @@map("tasks")
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime  @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  hours      Decimal   @default(0) @db.Decimal(6, 2)
  cycleId    String?
  pieceQty   Decimal?  @db.Decimal(18, 3)
  notes      String?
  clientId   String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle    Cycle?   @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date, cycleId])
  @@index([employeeId, date])
  @@index([cycleId])
  @@map("attendances")
}

model Payroll {
  id           String        @id @default(cuid())
  employeeId   String
  periodStart  DateTime      @db.Date
  periodEnd    DateTime      @db.Date
  amount       Decimal       @db.Decimal(18, 2)
  details      Json
  status       PayrollStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("PayrollApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId])
  @@index([status])
  @@map("payrolls")
}

model Customer {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  phone       String       @unique
  email       String?
  address     String?
  type        CustomerType @default(RETAIL)
  userId      String?
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User?        @relation("CustomerAccount", fields: [userId], references: [id])
  createdBy   User?        @relation("CustomersCreated", fields: [createdById], references: [id], onDelete: SetNull)
  salesOrders SalesOrder[]
  bookings    Booking[]

  @@index([type, isActive])
  @@map("customers")
}

model SalesOrder {
  id              String           @id @default(cuid())
  code            String           @unique
  customerId      String
  channel         SalesChannel
  status          SalesOrderStatus @default(PENDING)
  paymentStatus   PaymentStatus    @default(UNPAID)
  paymentMethod   PaymentMethod
  shippingAddress String
  subtotal        Decimal          @db.Decimal(18, 2)
  discount        Decimal          @db.Decimal(18, 2)
  shippingFee     Decimal          @db.Decimal(18, 2)
  total           Decimal          @db.Decimal(18, 2)
  notes           String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  warehouseId     String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  createdBy       User?            @relation("SalesOrdersCreated", fields: [createdById], references: [id], onDelete: SetNull)
  lines           SalesOrderLine[]
  payments        Payment[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@map("sales_orders")
}

model SalesOrderLine {
  id         String     @id @default(cuid())
  orderId    String
  productId  String?
  itemId     String
  stockLotId String?
  quantity   Decimal    @db.Decimal(18, 3)
  unitPrice  Decimal    @db.Decimal(18, 2)
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])
  stockLot   StockLot?  @relation(fields: [stockLotId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([itemId])
  @@map("sales_order_lines")
}

model Payment {
  id            String        @id @default(cuid())
  code          String        @unique
  orderId       String?
  bookingId     String?
  amount        Decimal       @db.Decimal(18, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  transactionId String?       @unique
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         SalesOrder?   @relation(fields: [orderId], references: [id])
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("PaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, paidAt])
  @@index([bookingId, paidAt])
  @@map("payments")
}

model FinanceCategory {
  id           String            @id @default(cuid())
  name         String
  type         TransactionType
  parentId     String?
  isActive     Boolean           @default(true)
  systemKey    String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  parent       FinanceCategory?  @relation("FinanceCategoryHierarchy", fields: [parentId], references: [id])
  children     FinanceCategory[] @relation("FinanceCategoryHierarchy")
  transactions Transaction[]

  @@index([type, isActive])
  @@index([parentId])
  @@map("finance_categories")
}

model Transaction {
  id          String          @id @default(cuid())
  code        String          @unique
  type        TransactionType
  categoryId  String
  amount      Decimal         @db.Decimal(18, 2)
  date        DateTime
  cycleId     String?
  refType     String?
  refId       String?
  method      PaymentMethod
  notes       String?
  mediaIds    String[]        @default([])
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    FinanceCategory @relation(fields: [categoryId], references: [id])
  cycle       Cycle?          @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("TransactionsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([type, date])
  @@index([cycleId])
  @@index([refType, refId])
  @@index([categoryId, date])
  @@map("transactions")
}

model Tour {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String
  durationMinutes Int
  priceAdult      Decimal    @db.Decimal(18, 2)
  priceChild      Decimal    @db.Decimal(18, 2)
  capacity        Int
  mediaIds        String[]   @default([])
  isPublished     Boolean    @default(false)
  sortOrder       Int        @default(0)
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy User?      @relation("ToursCreated", fields: [createdById], references: [id], onDelete: SetNull)
  slots     TourSlot[]

  @@index([isPublished, sortOrder])
  @@map("tours")
}

model TourSlot {
  id          String    @id @default(cuid())
  tourId      String
  startAt     DateTime
  capacity    Int
  bookedCount Int       @default(0)
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tour      Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("TourSlotsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  bookings  Booking[]

  @@unique([tourId, startAt])
  @@index([startAt])
  @@index([startAt, isActive])
  @@index([tourId, isActive])
  @@map("tour_slots")
}

model Booking {
  id            String         @id @default(cuid())
  code          String         @unique
  slotId        String
  customerName  String
  phone         String
  email         String?
  adults        Int
  children      Int            @default(0)
  total         Decimal        @db.Decimal(18, 2)
  status        BookingStatus  @default(PENDING)
  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?
  notes         String?
  customerId    String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  slot      TourSlot  @relation(fields: [slotId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("BookingsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([slotId])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([phone])
  @@index([slotId, createdAt])
  @@map("bookings")
}

model Equipment {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  type         String
  areaId       String?
  purchaseDate DateTime?
  value        Decimal?        @db.Decimal(18, 2)
  status       EquipmentStatus @default(ACTIVE)
  notes        String?
  isActive     Boolean         @default(true)
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  area                 Area?                 @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdBy            User?                 @relation("EquipmentsCreated", fields: [createdById], references: [id])
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs      MaintenanceLog[]

  @@index([areaId])
  @@index([status])
  @@map("equipments")
}

model MaintenanceSchedule {
  id           String   @id @default(cuid())
  equipmentId  String
  name         String
  intervalDays Int
  nextDueDate  DateTime
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  equipment       Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("MaintenanceSchedulesCreated", fields: [createdById], references: [id])
  maintenanceLogs MaintenanceLog[]

  @@index([equipmentId])
  @@index([nextDueDate])
  @@map("maintenance_schedules")
}

model MaintenanceLog {
  id            String          @id @default(cuid())
  equipmentId   String
  scheduleId    String?
  date          DateTime
  type          MaintenanceType
  cost          Decimal         @db.Decimal(18, 2)
  notes         String?
  performedById String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  equipment   Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  schedule    MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  performedBy User?                @relation("MaintenanceLogsPerformed", fields: [performedById], references: [id])
  createdBy   User?                @relation("MaintenanceLogsCreated", fields: [createdById], references: [id])

  @@index([equipmentId])
  @@index([scheduleId])
  @@index([date])
  @@map("maintenance_logs")
}

model Sensor {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  type         SensorType
  unit         String
  areaId       String
  apiKeyHash   String     @unique
  apiKeyPrefix String
  lastSeenAt   DateTime?
  isActive     Boolean    @default(true)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  area       Area            @relation(fields: [areaId], references: [id])
  createdBy  User?           @relation("SensorsCreated", fields: [createdById], references: [id])
  readings   SensorReading[]
  alertRules AlertRule[]

  @@index([areaId])
  @@index([type])
  @@index([apiKeyPrefix])
  @@map("sensors")
}

model SensorReading {
  id         BigInt   @id @default(autoincrement())
  sensorId   String
  value      Decimal  @db.Decimal(12, 4)
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, recordedAt])
  @@map("sensor_readings")
}

model AlertRule {
  id              String   @id @default(cuid())
  sensorId        String
  op              AlertOp
  threshold       Decimal  @db.Decimal(12, 4)
  isActive        Boolean  @default(true)
  cooldownMinutes Int      @default(30)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sensor    Sensor  @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AlertRulesCreated", fields: [createdById], references: [id])
  alerts    Alert[]

  @@index([sensorId])
  @@map("alert_rules")
}
