{
  "name": "@xfarm/db",
  "private": true,
  "version": "0.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts",
    "db:seed:content": "dotenv -e ../../.env -- tsx prisma/seed-content.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "postinstall": "prisma generate",
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests in db\"",
    "test:e2e": "echo \"no test:e2e in db\""
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.5",
    "@xfarm/config": "workspace:*",
    "argon2": "^0.41.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
