{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "2",
  "globalDependencies": [".env"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "db:migrate": {},
    "db:seed": {},
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:reset": {}
  }
}
