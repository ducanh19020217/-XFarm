# Copy to .env.production and replace every placeholder before deployment.

# Public URLs
WEB_URL=https://www.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Application
NODE_ENV=production
API_PORT=4100
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL (compose service hostname is postgres)
POSTGRES_USER=xfarm
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=xfarm
DATABASE_URL=postgresql://xfarm:replace-with-a-strong-database-password@postgres:5432/xfarm?schema=public

# Redis (compose service hostname is redis)
REDIS_URL=redis://redis:6379

# RustFS / S3 (compose service hostname is minio)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace-with-a-storage-access-key
MINIO_SECRET_KEY=replace-with-a-storage-secret-key
MINIO_BUCKET=xfarm-media
MINIO_USE_SSL=false
MINIO_ROOT_USER=replace-with-a-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-a-storage-secret-key

# Real SMTP provider; Mailpit is intentionally not part of production compose.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
